#!/usr/bin/env bash
set -euo pipefail

# FES — setup script
# Creates a virtual environment, installs the package with all
# dependencies, and verifies the installation.
#
# Usage:
#   ./configure                    # install the package and dependencies

HERE="$(cd "$(dirname "$0")" && pwd)"
VENV="$HERE/.venv"

# Resolve a Python interpreter: prefer Python 3.12, fall back to system python3.
PYTHON=""
for cand in python3.12 python3; do
    if command -v "$cand" >/dev/null 2>&1; then
        PYTHON="$cand"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "Error: no python3 interpreter found (need python3.12 or python3)" >&2
    exit 1
fi

PYVER="$("$PYTHON" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
echo "=== FES setup (python: $PYVER via $PYTHON) ==="

# 1. Create virtual environment
if [ ! -d "$VENV" ]; then
    echo "Creating virtual environment ..."
    "$PYTHON" -m venv "$VENV"
fi

# 2. Install package
echo "Installing package ..."
"$VENV/bin/python" -m pip install --quiet --upgrade pip

# Install a package spec, falling back to FEM-only core when an optional
# dependency (e.g. pyvista -> vtk) has no matching distribution for this
# Python version. Never lets a missing optional extra abort setup.
install_extras() {
    local pkgs=("$@")
    if ! "$VENV/bin/python" -m pip install --quiet "${pkgs[@]}"; then
        echo "Warning: optional dependencies could not be resolved (${pkgs[*]});" >&2
        echo "         continuing with FEM-only core." >&2
        return 1
    fi
}

if ! install_extras -e "$HERE[viz]" pytest; then
    "$VENV/bin/python" -m pip install --quiet -e "$HERE"
    "$VENV/bin/python" -m pip install --quiet pytest
fi

# 3. Optional ML extras
echo "Installing ML / DNN-GP dependencies ..."
if ! install_extras torch gpytorch scikit-learn; then
    echo "         DNN-GP surrogate projects unavailable until these install." >&2
fi

# 4. Verify
echo "Verifying installation ..."
"$VENV/bin/python" -c "
from fes import constants
print(f'FES OK')
try:
    import torch; print(f'  torch {torch.__version__}')
except: pass
try:
    import gpytorch; print(f'  gpytorch {gpytorch.__version__}')
except: pass
"

# 5. Check for mesh data
echo ""
if [ -d "$HERE/data" ] && ls "$HERE/data"/*.poly &>/dev/null 2>&1; then
    echo "Mesh files:  found in data/"
else
    echo "Mesh files:  none (generate with 'fes mesh <model>' or download separately)"
fi

# 6. Initialize submodules if the vendored sources aren't present yet.
if [ -d "$HERE/dep" ] && ! ls "$HERE/dep/triangle/triangle.cpp" "$HERE/dep/tetgen/tetgen.cxx" >/dev/null 2>&1; then
    echo "Initializing submodules ..."
    git -C "$HERE" submodule update --init >/dev/null 2>&1 || true
fi

# 7. Build native mesh libraries (Triangle / TetGen) if vendored
if [ -d "$HERE/dep/triangle" ] && [ -f "$HERE/tools/build_triangle.py" ]; then
    echo "Building Triangle mesh library ..."
    if "$VENV/bin/python" "$HERE/tools/build_triangle.py" >/dev/null 2>&1; then
        echo "  Triangle: built"
    else
        echo "  Triangle: build failed (2D meshing unavailable)"
    fi
fi
if [ -d "$HERE/dep/tetgen" ] && [ -f "$HERE/tools/build_tetgen.py" ]; then
    echo "Building TetGen mesh library ..."
    if "$VENV/bin/python" "$HERE/tools/build_tetgen.py" >/dev/null 2>&1; then
        echo "  TetGen: built"
    else
        echo "  TetGen: build failed (3D meshing unavailable)"
    fi
fi

# Verify at least one project can import
PYVER="$("$VENV/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
echo "Python:      $PYVER"
echo "Package:     FES"
echo ""
echo "Quick test:  $VENV/bin/python -m pytest tests/ -v"
echo "Run FDFD:    $VENV/bin/python -c 'from fes.projects import run_waveguide; run_waveguide()'"
echo "Run DNN-GP:  $VENV/bin/python -c 'from fes.projects import bilateral_filter_dnngp; print(\"import OK\")'"
echo ""
echo "=== done ==="
